{
    "name": "Nujabes",
    "variables": {
        "background": "#0d0a11",
        "dark_background": "#09070c",
        "lighter_background": "#231a2b",
        "foreground": "#e3dcda",
        "bright_foreground": "#fdf7f7",
        "dim_foreground": "#7d747a",
        "accent": "#b26ac6",
        "selection": "#3d2456",
        "muted": "#6b5268",
        "red": "#c56e6f",
        "yellow": "#e0c25a",
        "orange": "#e88b2c",
        "green": "#9aa06b",
        "cyan": "#7fa8b0",
        "blue": "#6d4fd0",
        "magenta": "#dc7fcc"
    },
    "globals": {
        "background": "var(background)",
        "foreground": "var(foreground)",
        "caret": "var(orange)",
        "line_highlight": "var(dark_background)",
        "selection": "var(selection)",
        "selection_foreground": "var(bright_foreground)",
        "inactive_selection": "var(lighter_background)",
        "find_highlight": "var(orange)",
        "find_highlight_foreground": "var(background)",
        "highlight": "var(accent)",
        "accent": "var(accent)",
        "gutter": "var(background)",
        "gutter_foreground": "var(muted)",
        "gutter_foreground_highlight": "var(orange)",
        "guide": "var(lighter_background)",
        "active_guide": "var(accent)",
        "stack_guide": "var(muted)",
        "brackets_foreground": "var(orange)",
        "tags_foreground": "var(accent)",
        "fold_marker": "var(muted)",
        "minimap_border": "var(muted)",
        "rulers": "var(lighter_background)",
        "line_diff_added": "var(green)",
        "line_diff_modified": "var(orange)",
        "line_diff_deleted": "var(red)"
    },
    "rules": [
        { "name": "Comments", "scope": "comment", "foreground": "var(muted)", "font_style": "italic" },
        { "name": "Documentation", "scope": "comment.block.documentation", "foreground": "var(dim_foreground)" },
        { "name": "Strings", "scope": "string", "foreground": "var(yellow)" },
        { "name": "Escape sequences", "scope": "constant.character.escape", "foreground": "var(orange)" },
        { "name": "Numbers", "scope": "constant.numeric", "foreground": "var(orange)" },
        { "name": "Language constants", "scope": "constant.language", "foreground": "var(magenta)" },
        { "name": "Other constants", "scope": "constant", "foreground": "var(orange)" },
        { "name": "Keywords", "scope": "keyword", "foreground": "var(accent)" },
        { "name": "Operators", "scope": "keyword.operator", "foreground": "var(cyan)" },
        { "name": "Storage", "scope": "storage", "foreground": "var(accent)" },
        { "name": "Types", "scope": "entity.name.type, support.type", "foreground": "var(cyan)" },
        { "name": "Functions", "scope": "entity.name.function, support.function", "foreground": "var(orange)" },
        { "name": "Classes", "scope": "entity.name.class, entity.name.struct", "foreground": "var(yellow)" },
        { "name": "Parameters", "scope": "variable.parameter", "foreground": "var(foreground)" },
        { "name": "Builtins", "scope": "variable.language, support.variable", "foreground": "var(magenta)" },
        { "name": "Properties", "scope": "variable.other.property, support.constant.property-value", "foreground": "var(cyan)" },
        { "name": "Tags", "scope": "entity.name.tag", "foreground": "var(accent)" },
        { "name": "Attributes", "scope": "entity.other.attribute-name", "foreground": "var(orange)" },
        { "name": "Punctuation", "scope": "punctuation", "foreground": "var(dim_foreground)" },
        { "name": "Separators", "scope": "punctuation.separator", "foreground": "var(foreground)" },
        { "name": "Markdown headings", "scope": "markup.heading", "foreground": "var(bright_foreground)", "font_style": "bold" },
        { "name": "Markdown heading marks", "scope": "punctuation.definition.heading", "foreground": "var(accent)" },
        { "name": "Markdown links", "scope": "markup.underline.link", "foreground": "var(accent)", "font_style": "underline" },
        { "name": "Markdown bold", "scope": "markup.bold", "foreground": "var(bright_foreground)", "font_style": "bold" },
        { "name": "Markdown italic", "scope": "markup.italic", "foreground": "var(yellow)", "font_style": "italic" },
        { "name": "Markdown code", "scope": "markup.raw", "foreground": "var(orange)" },
        { "name": "Inserted", "scope": "markup.inserted", "foreground": "var(green)" },
        { "name": "Deleted", "scope": "markup.deleted", "foreground": "var(red)" },
        { "name": "Invalid", "scope": "invalid", "foreground": "var(bright_foreground)", "background": "var(red)" }
    ]
}
